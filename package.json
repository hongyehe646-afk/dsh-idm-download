{
  "name": "dsh-idm-download",
  "version": "0.1.1",
  "description": "DeepSeek Harness (DSH) plugin: let the agent route its own slow/large downloads through Internet Download Manager. DSH 插件：让智能体把自己的下载交给 IDM 多线程加速。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "PITFALLS.md"
  ],
  "keywords": [
    "accelerator",
    "deepseek-harness",
    "download",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "github",
    "idm",
    "internet-download-manager",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongyehe646-afk/dsh-idm-download.git"
  },
  "homepage": "https://github.com/hongyehe646-afk/dsh-idm-download#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/hongyehe646-afk/dsh-idm-download/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/hongyehe646-afk/dsh-idm-download/archive/refs/heads/main.zip",
      "git": "https://github.com/hongyehe646-afk/dsh-idm-download.git"
    }
  }
}
